<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Galicia & Portugal - Jacob Davis</title>
  <meta name="description" content="Galicia & Portugal, a photographic collection by Jacob Davis.">
  <link rel="stylesheet" href="styles.css">
  
  <style>
    /* Styling for dynamic gallery features */
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .photo {
      position: relative;
      margin: 0;
      background: #f4f4f4;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .photo-wrapper {
      width: 100%;
      height: 350px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background-color: #eee;
    }

    .photo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      transition: transform 0.3s ease;
    }

    /* Rotation Utility Classes */
    .rotate-90  { transform: rotate(90deg); }
    .rotate-180 { transform: rotate(180deg); }
    .rotate-270 { transform: rotate(270deg); }

    .photo-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding: 0.5rem 0.75rem;
      box-sizing: border-box;
      background: #fff;
    }

    .rotate-btn {
      background: #eee;
      border: 1px solid #ccc;
      border-radius: 4px;
      padding: 4px 8px;
      cursor: pointer;
      font-size: 0.85rem;
    }

    .rotate-btn:hover {
      background: #ddd;
    }
  </style>
</head>
<body>
  <header class="site-header">
    <a class="site-title" href="index.html" aria-label="Jacob Davis - Home">
      <span>Jacob Davis</span>
      <span class="site-title-divider" aria-hidden="true"></span>
      <span class="site-title-section">Photographs</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="index.html">Collections</a>
      <a href="index.html#about">About</a>
    </nav>
  </header>

  <main>
    <article class="album">
      <header class="album-header">
        <a class="back-link" href="index.html">&larr; All collections</a>
        <div class="album-heading">
          <div>
            <p class="eyebrow">Collection 02</p>
            <h1>Galicia & Portugal</h1>
          </div>
          <dl class="album-metadata">
            <div>
              <dt>Date</dt>
              <dd>2026</dd>
            </div>
            <div>
              <dt>Location</dt>
              <dd>Galicia & Portugal</dd>
            </div>
          </dl>
        </div>
        <p class="album-description">
          A dynamic visual diary loaded directly from the repository.
        </p>
      </header>

      <!-- Dynamic gallery container -->
      <div id="photo-grid" class="photo-grid">
        <p id="loading-text">Loading gallery...</p>
      </div>

      <nav class="album-navigation" aria-label="Collection navigation">
        <a href="index.html">
          <span class="nav-label">Index</span>
          <span>All collections</span>
        </a>
      </nav>
    </article>
  </main>

  <footer class="site-footer">
    <p>&copy; <span id="year">2026</span> Jacob Davis</p>
    <a href="#top">Back to top &uarr;</a>
  </footer>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();

    // --- CONFIGURATION ---
    // Update these variables with your GitHub details:
    const GITHUB_USERNAME = "your-github-username";
    const GITHUB_REPO = "your-repo-name";
    const FOLDER_PATH = "galicia-portugal"; // The folder containing your images
    const BRANCH = "main"; // Or "master"

    const apiUrl = `https://api.github.com/repos/${GITHUB_USERNAME}/${GITHUB_REPO}/contents/${FOLDER_PATH}`;
    const photoGrid = document.getElementById("photo-grid");

    // Fetch image directory from GitHub API
    async function loadGallery() {
      try {
        const response = await fetch(apiUrl);
        if (!response.ok) throw new Error("Unable to fetch repository files.");
        
        const files = await response.json();
        
        // Filter for image extensions
        const imageExtensions = [".jpg", ".jpeg", ".png", ".webp", ".gif"];
        const imageFiles = files.filter(file => 
          imageExtensions.some(ext => file.name.toLowerCase().endsWith(ext))
        );

        if (imageFiles.length === 0) {
          photoGrid.innerHTML = "<p>No images found in the specified directory.</p>";
          return;
        }

        // Clear loading state
        photoGrid.innerHTML = "";

        // Build gallery items dynamically
        imageFiles.forEach((file, index) => {
          const rawImageUrl = `https://raw.githubusercontent.com/${GITHUB_USERNAME}/${GITHUB_REPO}/${BRANCH}/${FOLDER_PATH}/${file.name}`;
          
          const figure = document.createElement("figure");
          figure.className = "photo";
          
          figure.innerHTML = `
            <div class="photo-wrapper">
              <img id="img-${index}" src="${rawImageUrl}" alt="${file.name}" loading="lazy" data-rotation="0">
            </div>
            <div class="photo-controls">
              <figcaption>${file.name}</figcaption>
              <button class="rotate-btn" onclick="rotateImage('img-${index}')">rotate ↻</button>
            </div>
          `;

          photoGrid.appendChild(figure);
        });
      } catch (error) {
        photoGrid.innerHTML = `<p>Error loading photos: ${error.message}</p>`;
      }
    }

    // Function to handle image rotation cycles (0deg -> 90deg -> 180deg -> 270deg -> 0deg)
    function rotateImage(imageId) {
      const img = document.getElementById(imageId);
      let currentRotation = parseInt(img.getAttribute("data-rotation"), 10) || 0;
      
      currentRotation = (currentRotation + 90) % 360;
      img.setAttribute("data-rotation", currentRotation);
      
      img.className = ""; // Reset rotation classes
      if (currentRotation > 0) {
        img.classList.add(`rotate-${currentRotation}`);
      }
    }

    // Trigger loading on page load
    loadGallery();
  </script>
</body>
</html>
